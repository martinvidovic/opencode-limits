{
  "name": "opencode-limits",
  "version": "0.1.1-rc.1",
  "description": "Native OpenCode v2 /limits popup for connected provider usage limits",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    }
  },
  "engines": {
    "node": ">=22.14.0",
    "opencode": ">=2.0.18 <3"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.18 <3"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run verify:package",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@linters/eslint-config-typescript": "2.5.1",
    "@linters/prettier-config": "2.1.1",
    "@opencode/plugin": "2.0.18",
    "@types/node": "22.13.4",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.5.3",
    "typescript": "5.8.2",
    "vitest": "3.0.8"
  }
}
